{
    "name": "avidmx",
    "description": "AVI demultiplexer",
    "filters":["avidmx"],
    "help": "This filter demultiplexes AVI.",
    "support": [
        "video"
    ],
    "sources":"https://codeload.github.com/Bevara/avidmx/zip/refs/heads/main",
    "filter_source":{
        "avidmx" : "dmx_avi.c"
    },
    "Format":	["AVI"],
    "using": ["solver_1"],
    "runtime": {
        "avidmx": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_BGR"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "AVI container",
        "checked": "2026-10-16"
    }
}
